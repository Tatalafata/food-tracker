# Chiave privata: usata soltanto dal servizio locale, mai dall'app.
OPENAI_API_KEY=your_openai_api_key_here
# Anteprima sul PC. Per telefoni serve un backend HTTPS autenticato.
EXPO_PUBLIC_RECIPES_API_URL=http://localhost:3001
# Per il servizio remoto Supabase usa la chiave Publishable del progetto.
EXPO_PUBLIC_RECIPES_PUBLISHABLE_KEY=
# URL pubblico del modulo Formspree. Vuoto finché il feedback non è attivo.
EXPO_PUBLIC_FEEDBACK_URL=
# Progetto Supabase e chiave publishable per la copia online facoltativa.
EXPO_PUBLIC_PROFILE_URL=
EXPO_PUBLIC_PROFILE_KEY=
